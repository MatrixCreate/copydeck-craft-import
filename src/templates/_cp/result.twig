{% extends '_layouts/cp' %}

{% set title = 'Import Result' %}

{% set crumbs = [
    { label: 'ContentiQ', url: url('contentiq-importer') },
] %}

{% block actionButton %}
    <a class="btn submit add icon" href="{{ url('contentiq-importer/upload') }}">
        {{ 'New Import'|t('contentiq-importer') }}
    </a>
{% endblock %}

{% block content %}

    {# Overall status banner #}
    {% if run.status == 'success' %}
        <div class="pane" style="background:var(--green-050); border:1px solid var(--green-300); margin-bottom:24px; padding:16px; border-radius:8px;">
            <span class="status green"></span>
            <strong>{{ 'Import completed successfully'|t('contentiq-importer') }}</strong>
        </div>
    {% elseif run.status == 'warnings' %}
        <div class="pane" style="background:var(--yellow-050); border:1px solid var(--yellow-300); margin-bottom:24px; padding:16px; border-radius:8px;">
            <span class="status orange"></span>
            <strong>{{ 'Import completed with warnings'|t('contentiq-importer') }}</strong>
        </div>
    {% else %}
        <div class="pane" style="background:var(--red-050); border:1px solid var(--red-300); margin-bottom:24px; padding:16px; border-radius:8px;">
            <span class="status red"></span>
            <strong>{{ 'Import completed with errors'|t('contentiq-importer') }}</strong>
        </div>
    {% endif %}

    {# Summary stats #}
    <div style="display:flex; gap:24px; margin-bottom:24px;">
        <div class="pane" style="padding:16px; flex:1; text-align:center;">
            <div style="font-size:24px; font-weight:bold;">{{ run.pageCount }}</div>
            <div class="light">{{ run.pageCount == 1 ? 'Page' : 'Pages' }}</div>
        </div>
        <div class="pane" style="padding:16px; flex:1; text-align:center;">
            <div style="font-size:24px; font-weight:bold;">{{ run.imageCount }}</div>
            <div class="light">Images</div>
        </div>
        <div class="pane" style="padding:16px; flex:1; text-align:center;">
            <div style="font-size:24px; font-weight:bold;">{{ run.type == 'batch' ? 'Batch' : 'Single' }}</div>
            <div class="light">Import type</div>
        </div>
        <div class="pane" style="padding:16px; flex:1; text-align:center;">
            <div style="font-size:24px; font-weight:bold;">{{ run.dateCreated|date('H:i') }}</div>
            <div class="light">{{ run.dateCreated|date('j M Y') }}</div>
        </div>
    </div>

    {# Per-page results. Belt-and-braces unwrap (Fix B-result): the controller
       redirects 'sync' runs to the purpose-built sync-result screen, whose
       result is a shape-tagged object ({pages, globals, ackWarning}) instead
       of this screen's flat per-page array — this fallback (mirrors the one
       already in sync-result.twig) means any other code path or old bookmark
       that still lands here on a wrapped result degrades to the actual pages
       instead of iterating the 3 top-level keys as garbage rows. #}
    {% set pages = run.result.pages is defined ? run.result.pages : run.result %}
    {% if pages is iterable %}
        <h2>{{ 'Pages'|t('contentiq-importer') }}</h2>
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ 'Slug'|t('contentiq-importer') }}</th>
                    <th>{{ 'Status'|t('contentiq-importer') }}</th>
                    <th>{{ 'Blocks'|t('contentiq-importer') }}</th>
                    <th>{{ 'Images'|t('contentiq-importer') }}</th>
                    <th>{{ 'SEO'|t('contentiq-importer') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for page in pages %}
                    <tr>
                        <td><strong>{{ page.slug ?? '?' }}</strong></td>
                        <td>
                            {% if page.success ?? false %}
                                <span class="status green"></span> OK
                            {% else %}
                                <span class="status red"></span> Failed
                            {% endif %}
                        </td>
                        <td>
                            {% set blockCount = 0 %}
                            {% for block in page.blocks ?? [] %}
                                {% if not block.skipped %}
                                    {% set blockCount = blockCount + 1 %}
                                {% endif %}
                            {% endfor %}
                            {{ blockCount }}
                        </td>
                        <td>{{ (page.images ?? [])|length }}</td>
                        <td>{{ page.seoFieldCount ?? 0 }} fields</td>
                        <td class="thin">
                            {% if page.entryId ?? null %}
                                <a href="{{ cpUrl('entries/pages/' ~ page.entryId) }}" class="btn small" target="_blank">
                                    {{ 'View Entry'|t('contentiq-importer') }}
                                </a>
                            {% endif %}
                        </td>
                    </tr>

                    {# Warnings, errors, blockNotes, and routingNotes for this page.
                       blockNotes is payload-authored (ContentIQ's own block.notes);
                       routingNotes is plugin-generated (e.g. CTA global-routing
                       messages — see ImportService::_resolveCtaBlocks()). Both are
                       informational, not actionable — rendered muted via .light,
                       separately from .warning/.error, and never counted toward
                       run status. #}
                    {% set blockNotes = (page.blockNotes ?? '')|trim %}
                    {% set routingNotes = (page.routingNotes ?? '')|trim %}
                    {# failed is folded into the totals (not just created+reused)
                       so a payload item that failed with nothing else to report
                       still renders this row instead of silently vanishing. #}
                    {% set pageAssetsTotal = (page.pageAssets.created ?? 0) + (page.pageAssets.reused ?? 0) + (page.pageAssets.failed ?? 0) %}
                    {% set pageFilesTotal = (page.pageFiles.created ?? 0) + (page.pageFiles.reused ?? 0) + (page.pageFiles.failed ?? 0) %}
                    {% set placeholdersDropped = page.placeholdersDropped ?? 0 %}
                    {% if (page.warnings ?? [])|length or page.error ?? null or blockNotes != '' or routingNotes != '' or pageAssetsTotal or pageFilesTotal or placeholdersDropped %}
                        <tr>
                            <td colspan="6" style="padding-left:32px;">
                                {% if page.error ?? null %}
                                    <div class="error">{{ page.error }}</div>
                                {% endif %}
                                {% for warning in page.warnings ?? [] %}
                                    <div class="warning">{{ warning }}</div>
                                {% endfor %}
                                {% if blockNotes != '' %}
                                    {% for note in blockNotes|split('\n\n') %}
                                        <div class="light">{{ note }}</div>
                                    {% endfor %}
                                {% endif %}
                                {% if routingNotes != '' %}
                                    {% for note in routingNotes|split('\n\n') %}
                                        <div class="light">{{ note }}</div>
                                    {% endfor %}
                                {% endif %}
                                {# Page-level assets[]/files[] filing — independent of any
                                   field, so it's reported separately from the Images
                                   column (block/hero/SEO/card images only). Present on a
                                   locked-skip row too — asset filing is exempt from the
                                   lock, see ImportService::importPageAssetsOnly(). #}
                                {% if pageAssetsTotal or pageFilesTotal %}
                                    <div class="light">
                                        {% if pageAssetsTotal %}{{ (page.pageAssets.created ?? 0) }} new page asset{{ (page.pageAssets.created ?? 0) == 1 ? '' : 's' }}, {{ (page.pageAssets.reused ?? 0) }} reused ({{ (page.pageAssets.relocated ?? 0) }} relocated){% if page.pageAssets.failed ?? 0 %}, <span style="color:var(--warning-color);">{{ page.pageAssets.failed }} failed</span>{% endif %}{% endif %}
                                        {%- if pageAssetsTotal and pageFilesTotal %} &middot; {% endif -%}
                                        {% if pageFilesTotal %}{{ (page.pageFiles.created ?? 0) }} new page file{{ (page.pageFiles.created ?? 0) == 1 ? '' : 's' }}, {{ (page.pageFiles.reused ?? 0) }} reused ({{ (page.pageFiles.relocated ?? 0) }} relocated){% if page.pageFiles.failed ?? 0 %}, <span style="color:var(--warning-color);">{{ page.pageFiles.failed }} failed</span>{% endif %}{% endif %}
                                    </div>
                                {% endif %}
                                {# Bracketed placeholder nodes (e.g. "[Product grid]") dropped
                                   rather than written into this page's rich text — see
                                   NodesRenderer::getPlaceholderCount(). #}
                                {% if placeholdersDropped %}
                                    <div class="light">
                                        {{ placeholdersDropped }} placeholder{{ placeholdersDropped == 1 ? '' : 's' }} stripped
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>

        {# Block detail per page #}
        {% for page in pages %}
            {% if (page.blocks ?? [])|length %}
                <div style="margin-top:24px;">
                    <h3>{{ page.slug ?? '?' }} &mdash; Blocks</h3>
                    <ul>
                        {% for block in page.blocks %}
                            <li>
                                {% if block.skipped %}
                                    <span class="status orange"></span>
                                    <code>{{ block.type }}</code> &mdash; skipped
                                {% else %}
                                    <span class="status green"></span>
                                    <code>{{ block.type }}</code>
                                    {% if block.fields|length %}
                                        &mdash; {{ block.fields|join(', ') }}
                                    {% endif %}
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}

{% endblock %}
