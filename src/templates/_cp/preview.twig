{% extends '_layouts/cp' %}

{% set title = 'Preview Import' %}

{% set crumbs = [
    { label: 'ContentiQ', url: url('contentiq-importer') },
    { label: 'Upload', url: url('contentiq-importer/upload') },
] %}

{% block content %}

    {# Summary bar #}
    <div class="contentiq-summary" style="margin-bottom:24px; padding:16px; background:var(--gray-050); border-radius:8px; display:flex; gap:24px; align-items:center; flex-wrap:wrap;">
        <div>
            <strong>{{ isBatch ? 'Batch' : 'Single page' }}</strong>
            &middot;
            {{ pageCount }} {{ pageCount == 1 ? 'page' : 'pages' }}
        </div>
        {% if exportDate %}
            <div class="light">Exported {{ exportDate }}</div>
        {% endif %}
        <div style="margin-left:auto; display:flex; gap:12px; align-items:center;">
            {% if createCount %}
                <span class="status green" style="margin-right:0;"></span> {{ createCount }} will be created
            {% endif %}
            {% if updateCount %}
                <span class="status blue" style="margin-right:0;"></span> {{ updateCount }} will be updated
            {% endif %}
            {% if totalWarnings %}
                <span class="status orange" style="margin-right:0;"></span> {{ totalWarnings }} {{ totalWarnings == 1 ? 'warning' : 'warnings' }}
            {% endif %}
        </div>
    </div>

    {# Block type labels — human-readable names for ContentIQ machine types #}
    {% set blockLabels = {
        'text': 'Text',
        'text_and_media': 'Text & Media',
        'faq': 'FAQ',
        'cards': 'Cards',
        'price_list': 'Price List',
        'usp': 'USP',
        'global': 'Global',
        'collection_listing': 'Collection Listing',
        'image_gallery': 'Image Gallery',
        'hero': 'Hero',
        'call_to_action': 'Call to Action',
        'table': 'Table',
    } %}

    {# Pages table #}
    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Title'|t('contentiq-importer') }}</th>
                <th>{{ 'Slug'|t('contentiq-importer') }}</th>
                <th>{{ 'Blocks'|t('contentiq-importer') }}</th>
                <th>{{ 'Images'|t('contentiq-importer') }}</th>
                <th>{{ 'Action'|t('contentiq-importer') }}</th>
                <th>{{ 'Warnings'|t('contentiq-importer') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for page in pages %}
                <tr>
                    <td>
                        <strong>{{ page.title ?? page.slug }}</strong>
                    </td>
                    <td><code>{{ page.slug }}</code></td>
                    <td>
                        {% set blockTypes = [] %}
                        {% for block in page.blocks %}
                            {% if not block.skipped %}
                                {% set blockTypes = blockTypes|merge([blockLabels[block.type] ?? block.type]) %}
                            {% endif %}
                        {% endfor %}
                        {{ blockTypes|join(', ') }}
                    </td>
                    <td>{{ page.images|length }}</td>
                    <td style="white-space:nowrap;">
                        {% if page.willCreate %}
                            <span class="status green"></span> Create
                        {% else %}
                            <span class="status blue"></span> Update
                            {% if page.existingId %}
                                <a href="{{ cpUrl('entries/pages/' ~ page.existingId) }}" class="go small" target="_blank" title="View in CP"></a>
                            {% endif %}
                        {% endif %}
                    </td>
                    <td>
                        {% if page.warnings|length %}
                            {% for warning in page.warnings %}
                                <div class="warning">{{ warning }}</div>
                            {% endfor %}
                        {% else %}
                            <span class="light">&mdash;</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Globals panel — dry-run summary of the file's globals payload. The upload
       path does not import globals (that needs the Sync consent model), so this
       is informational: it shows what a Sync of this file would write. #}
    {% if globalsPreview %}
        {% set offices = globalsPreview.offices ?? {} %}
        <div style="margin-top:32px;">
            <h2>{{ 'Globals'|t('contentiq-importer') }}</h2>
            <p class="light" style="margin-top:-4px;">
                {{ 'Uploads do not import globals — use Sync to apply them. This is a preview of what a Sync would do.'|t('contentiq-importer') }}
            </p>

            <div class="pane" style="border-radius:8px; padding:16px; margin-bottom:16px;">
                <div style="font-size:14px; margin-bottom:12px;">
                    <strong>{{ (offices.created ?? [])|length }}</strong> to create
                    &middot; <strong>{{ (offices.updated ?? [])|length }}</strong> to update
                    &middot; <strong>{{ (offices.adopted ?? [])|length }}</strong> to adopt
                    &middot; <strong>{{ (offices.deleted ?? [])|length }}</strong> to delete
                    &middot; <strong>{{ (offices.unmatched ?? [])|length }}</strong> left alone
                </div>

                {% for label, key in { 'Create': 'created', 'Update': 'updated', 'Adopt': 'adopted', 'Delete': 'deleted', 'Left alone (hand-made)': 'unmatched' } %}
                    {% if (offices[key] ?? [])|length %}
                        <div style="font-size:13px; margin-bottom:4px;">
                            <span class="light">{{ label }}:</span> {{ offices[key]|join(', ') }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            {% if (globalsPreview.globalSets ?? {})|length %}
                <div class="pane" style="border-radius:8px; padding:16px; margin-bottom:16px;">
                    <strong style="display:block; margin-bottom:8px;">{{ 'Global set fields'|t('contentiq-importer') }}</strong>
                    {% for setHandle, handles in globalsPreview.globalSets %}
                        <div style="font-size:13px; margin-bottom:4px;">
                            <code>{{ setHandle }}</code>
                            <span class="light">— {{ handles|length ? handles|join(', ') : 'none' }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% set globalsNotes = (globalsPreview.warnings ?? [])|merge(globalsPreview.drift ?? [])|merge(globalsPreview.fieldNotes ?? []) %}
            {% if globalsNotes|length %}
                <div class="pane" style="background:var(--yellow-050); border:1px solid var(--yellow-300); border-radius:8px; padding:16px;">
                    <strong style="display:block; margin-bottom:8px;">{{ 'Globals warnings and notes'|t('contentiq-importer') }}</strong>
                    <ul style="margin:0; padding-left:20px;">
                        {% for note in globalsNotes %}
                            <li style="margin-bottom:4px; font-size:13px;">{{ note }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>
    {% endif %}

    {# Skipped blocks detail #}
    {% set skippedBlocks = [] %}
    {% for page in pages %}
        {% for block in page.blocks %}
            {% if block.skipped %}
                {% set skippedBlocks = skippedBlocks|merge([{ page: page.slug, type: block.type }]) %}
            {% endif %}
        {% endfor %}
    {% endfor %}

    {% if skippedBlocks|length %}
        <div style="margin-top:24px;">
            <h3>{{ 'Skipped Blocks'|t('contentiq-importer') }}</h3>
            <ul>
                {% for skipped in skippedBlocks %}
                    <li class="light">{{ skipped.page }}: <code>{{ skipped.type }}</code> (unknown block type)</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    {# Actions #}
    <div style="margin-top:24px; display:flex; gap:12px;">
        <a href="{{ url('contentiq-importer/upload') }}" class="btn">
            {{ 'Back'|t('contentiq-importer') }}
        </a>

        <form method="post">
            {{ csrfInput() }}
            {{ actionInput('contentiq-importer/cp/run-import') }}
            <input type="hidden" name="tempFilename" value="{{ tempFilename }}">
            <button type="submit" class="btn submit">
                {{ 'Import'|t('contentiq-importer') }}
            </button>
        </form>
    </div>

{% endblock %}
